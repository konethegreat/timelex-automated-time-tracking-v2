# Set to your disposable local PostgreSQL database (no shared credentials).
DATABASE_URL=""

# Generate a fresh random value; never commit the configured .env file.
AUTH_SECRET=""

# Optional Microsoft Entra ID identity provider.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

ALLOW_DEV_AUTH_BYPASS=false
SYNC_GATEWAY_SIMULATE_FAILURE=false
NEXT_PUBLIC_TIMELEX_DEMO_MODE=false
