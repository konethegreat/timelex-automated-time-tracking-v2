// DATABASE_URL is configured in prisma.config.ts (required for Prisma 7+)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  FIRM_ADMIN
  FEE_EARNER
}

enum ActivityType {
  EMAIL
  CALL
  RESEARCH
  DOCUMENT
  MEETING
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
}

model Organization {
  id               String      @id @default(uuid())
  name             String
  domain           String      @unique
  subscriptionTier String      @default("Standard")
  createdAt        DateTime    @default(now())
  users            User[]
  matters          Matter[]
  drafts           Draft[]
  timeEntries      TimeEntry[]
}

model User {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  email                 String       @unique
  passwordHash          String?
  role                  UserRole     @default(FEE_EARNER)
  defaultHourlyRate     Decimal      @db.Decimal(10, 2)
  monthlyBillableTarget Int          @default(120)
  createdAt             DateTime     @default(now())
  drafts                Draft[]
  timeEntries           TimeEntry[]
}

model Matter {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matterNumber   String       @unique
  clientName     String
  description    String
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  drafts         Draft[]
  timeEntries    TimeEntry[]
}

model Draft {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId       String?
  matter         Matter?      @relation(fields: [matterId], references: [id], onDelete: SetNull)
  activityType   ActivityType
  sourcePlatform String       @default("Outlook")
  units          Int          @default(1) // 1 unit = 6 minutes
  suggestedText  String       @db.Text
  timestamp      DateTime     @default(now())
}

model TimeEntry {
  id                  String       @id @default(uuid())
  organizationId      String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId            String
  matter              Matter       @relation(fields: [matterId], references: [id], onDelete: Restrict)
  units               Int
  finalizedText       String       @db.Text
  hourlyRateApplied   Decimal      @db.Decimal(10, 2)
  totalValue          Decimal      @db.Decimal(10, 2)
  syncStatus          SyncStatus   @default(PENDING)
  syncLock            Boolean      @default(false)
  createdAt           DateTime     @default(now())
}
