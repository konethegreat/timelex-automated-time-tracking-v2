// TimeLex — Multi-tenant B2B legal time capture (Ghost Practice integration layer)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  FIRM_ADMIN
  FEE_EARNER
}

enum MatterStatus {
  ACTIVE
  ARCHIVED
}

enum ActivityType {
  EMAIL
  CALL
  DOCUMENT
  REVIEW
}

enum SourcePlatform {
  OUTLOOK
  TEAMS
  LOCAL
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
}

// ---------------------------------------------------------------------------
// Tenant & domain
// ---------------------------------------------------------------------------

model Organization {
  id               String           @id @default(cuid())
  name             String
  domain           String           @unique // e.g. mbmotsoeneng.co.za — used for tenant routing
  subscriptionTier SubscriptionTier @default(STARTER)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users       User[]
  matters     Matter[]
  drafts      Draft[]
  timeEntries TimeEntry[]

  @@index([domain])
}

model User {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String?
  email                 String
  emailVerified         DateTime?
  image                 String?
  role                  UserRole  @default(FEE_EARNER)
  defaultHourlyRate     Decimal   @default(0) @db.Decimal(10, 2)
  monthlyBillableTarget Decimal   @default(160) @db.Decimal(10, 2)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts     Account[]
  sessions     Session[]
  drafts       Draft[]
  timeEntries  TimeEntry[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
}

model Matter {
  id             String       @id @default(cuid())
  organizationId String
  matterNumber   String
  clientName     String
  areaOfLaw      String?
  status         MatterStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  drafts       Draft[]
  timeEntries  TimeEntry[]

  @@unique([organizationId, matterNumber])
  @@index([organizationId, status])
  @@index([organizationId, clientName])
}

model Draft {
  id                 String         @id @default(cuid())
  organizationId     String
  userId             String
  matterId           String?
  activityType       ActivityType
  sourcePlatform     SourcePlatform
  units              Int // 6-minute billing increments
  suggestedNarration String         @db.Text
  timestamp          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter       Matter?      @relation(fields: [matterId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, timestamp])
  @@index([organizationId, matterId])
}

model TimeEntry {
  id                 String     @id @default(cuid())
  organizationId     String
  userId             String
  matterId           String
  units              Int
  finalizedNarration String     @db.Text
  totalValue         Decimal    @db.Decimal(12, 2)
  syncStatus         SyncStatus @default(PENDING)
  syncLock           Boolean    @default(false)
  approvedAt         DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter       Matter       @relation(fields: [matterId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, syncStatus])
  @@index([organizationId, matterId])
  @@index([organizationId, syncLock])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) adapter
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
